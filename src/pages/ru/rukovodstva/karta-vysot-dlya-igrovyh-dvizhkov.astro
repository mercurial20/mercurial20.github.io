---
import { Image } from 'astro:assets';
import Article from '../../../layouts/Article.astro';
import { IMG } from '../../../images';
import { howTo } from '../../../howto';
import { EDITOR, routeIn } from '../../../i18n';

const steps = [
  { name: 'Сделайте или сгенерируйте рельеф', text: 'Сгенерируйте мир или вылепите его в редакторе. У каждой точки настоящая высота в метрах, поэтому карта высот — это данные, а не картинка отмывки.' },
  { name: 'Откройте «Экспорт» → «Карта высот»', text: 'Нажмите «Экспорт» в верхней панели и выберите «Карта высот».' },
  { name: 'Выберите 16 бит', text: 'Выберите «16 бит (рекомендуется)»: 65 536 ступеней высоты вместо 256, склоны без «лесенки». 8 бит — для программ, которые не читают 16-битные изображения.' },
  { name: 'Выберите ширину', text: 'Выберите 1024, 2048 px или полную ширину карты. Плоская карта выгружается сверху в одном масштабе; планета — в равнопромежуточной проекции.' },
  { name: 'Выгрузите и запомните диапазон высот', text: 'Нажмите «Экспортировать карту высот». Чёрный — самая низкая высота, белый — самая высокая; диапазон в метрах записан в имени файла (например …-heightmap-16bit_-11000m_to_10000m.png) и в метаданных PNG. Между ними высоты линейны.' },
  { name: 'Импортируйте в движок или 3D-программу', text: 'Загрузите серый PNG в импорт ландшафта движка и задайте вертикальный масштаб так, чтобы полный диапазон изображения соответствовал диапазону из имени файла.' },
];
const title = 'Карта высот фэнтези-мира для Unreal, Unity, Godot и Blender | Loremapper';
const description = 'Как выгрузить 16-битную карту высот сгенерированного фэнтези-мира из Loremapper и загрузить её в игровой движок или 3D-программу, с диапазоном высот в метрах. Бесплатно, в браузере.';
---

<Article
  lang="ru"
  page="tutHeightmap"
  title={title}
  description={description}
  h1="Как выгрузить карту высот для игровых движков"
  crumb="Карта высот"
  parent={{ page: 'guides', name: 'Руководства' }}
  article={{ published: '2026-11-06', modified: '2026-11-06' }}
  schema={[howTo({ name: 'Как выгрузить карту высот из Loremapper для игрового движка', description, url: routeIn('tutHeightmap', 'ru'), steps, minutes: 5, lang: 'ru' })]}
>
  <p class="lead">
    Loremapper хранит настоящие высоты, поэтому сгенерированный или вылепленный мир может стать ландшафтом в игровом движке или 3D-сцене.
  </p>
  <figure>
    <Image class="shot" src={IMG.exportShot} alt="Окно экспорта в Loremapper: картинка карты, карта высот и проект" width={1200} widths={[760, 1200]} sizes="(max-width: 860px) 100vw, 760px" />
  </figure>
  <h2>Шаги</h2>
  <ol class="steps">
    {steps.map((s, i) => (
      <li id={`step-${i + 1}`}>
        <b>{s.name}.</b> {s.text}
      </li>
    ))}
  </ol>
  <h2>Заметки для популярных программ</h2>
  <p>Импорт меняется от версии к версии, сверяйтесь с документацией; вот обычная отправная точка.</p>
  <ul>
    <li><b>Unreal Engine:</b> импорт Landscape читает 16-битный серый PNG. Задайте масштаб по Z так, чтобы полный диапазон соответствовал метрам из имени файла.</li>
    <li><b>Unity:</b> встроенный Terrain импортирует карты высот в формате RAW; сначала переведите PNG в 16-битный RAW в графическом редакторе и задайте высоту ландшафта по диапазону.</li>
    <li><b>Godot:</b> дополнения для ландшафта импортируют серые карты высот; задайте их масштаб высоты по диапазону.</li>
    <li><b>Blender:</b> используйте PNG как текстуру модификатора Displace (или узла смещения) на подразделённой плоскости.</li>
  </ul>
  <p>Горизонтальный масштаб — из размера карты: плоская карта 2000 км при ширине 2048 px — около 1 км на пиксель.</p>
  <h2>Дальше</h2>
  <p>
    <a href={routeIn('tutContinent', 'ru')}>Сгенерируйте материк</a> для выгрузки или <a href={EDITOR}>откройте редактор</a>.
  </p>
</Article>
