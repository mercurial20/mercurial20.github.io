---
import Article from '../../../layouts/Article.astro';
import { EDITOR, routeIn } from '../../../i18n';

const guides = [
  { id: 'tutContinent', name: 'Сгенерировать фэнтези-материк', text: 'Размер, форма, климат, ветер, сид и варианты — правдоподобный материк за несколько минут.' },
  { id: 'tutFog', name: 'Карта для игроков с туманом войны', text: 'Спрятать то, чего партия не видела, и выгрузить карту для игроков — для D&D и любой НРИ.' },
  { id: 'tutHeightmap', name: 'Карта высот для игровых движков', text: '16-битный серый рельеф с диапазоном высот — для Unreal, Unity, Godot и Blender.' },
  { id: 'guide', name: 'Как сделать фэнтези-карту', text: 'Семь шагов к карте, похожей на настоящую: масштаб, побережья, горы, реки, климат, города, названия.' },
] as const;
---

<Article
  lang="ru"
  page="guides"
  title="Руководства по фэнтези-картам | Loremapper"
  description="Бесплатные пошаговые руководства по Loremapper: сгенерировать материк, сделать карту для игроков D&D с туманом войны, выгрузить карту высот для игрового движка и спроектировать правдоподобный мир."
  h1="Руководства"
  crumb="Руководства"
>
  <p class="lead">Пошаговые руководства по созданию фэнтези-карт в Loremapper. Каждое занимает несколько минут; редактор бесплатный и без регистрации.</p>
  <div class="links-grid">
    {
      guides.map((g) => (
        <a class="link-card" href={routeIn(g.id, 'ru')}>
          <h3>{g.name}</h3>
          <p>{g.text}</p>
        </a>
      ))
    }
  </div>
  <p>Готовы? <a href={EDITOR}>Откройте редактор</a>.</p>
</Article>
