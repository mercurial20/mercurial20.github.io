---
import { Image } from 'astro:assets';
import Article from '../../../layouts/Article.astro';
import { IMG } from '../../../images';
import { howTo } from '../../../howto';
import { EDITOR, routeIn } from '../../../i18n';

const steps = [
  { name: 'Откройте карту кампании', text: 'Откройте в редакторе карту вашего мира или сгенерируйте её. Сначала расставьте города, дороги и места, нужные сюжету: туман прячет их от игроков, а не от вас.' },
  { name: 'Выберите инструмент «Туман войны»', text: 'Нажмите X или выберите «Туман войны» на панели инструментов. У кисти два режима: «Скрыть» закрашивает туманом, «Открыть» стирает его.' },
  { name: 'Закройте всю карту', text: 'Нажмите «Закрыть всю карту», чтобы спрятать всё сразу, и переключите кисть на «Открыть».' },
  { name: 'Откройте то, что знает партия', text: 'Проведите кистью «Открыть» по местам, которые персонажи видели. Непрозрачность задаёт плотность тумана: при 50% игроки видят землю как сквозь дымку. Shift или Alt на ходу переключают скрытие и открытие.' },
  { name: 'Проверьте, что увидят игроки', text: 'В верхней панели переключается «Видеть сквозь туман» (для вас, во время работы) и «Вид игрока» (карта такой, какой её увидят игроки).' },
  { name: 'Выгрузите карту для игроков', text: 'Откройте «Экспорт» → «Изображение карты», в поле «Туман войны» выберите «Только открытые области (карта игрока)», задайте область и ширину и нажмите «Экспортировать PNG». Для себя выгрузите ещё раз с «Полная карта (без тумана)».' },
  { name: 'Открывайте больше после каждой игры', text: 'По мере путешествия партии открывайте новые места кистью и выгружайте свежую карту. Карта сохраняется в браузере; файл проекта («Экспорт» → «Редактируемый проект») — полная резервная копия.' },
];
const title = 'Как сделать карту для игроков D&D с туманом войны (бесплатно) | Loremapper';
const description = 'По шагам: скрыть неразведанные земли туманом войны, открыть то, что видела партия, и выгрузить карту для игроков — для D&D, Pathfinder и любой НРИ. Бесплатно, в браузере.';
---

<Article
  lang="ru"
  page="tutFog"
  title={title}
  description={description}
  h1="Как сделать карту для игроков с туманом войны"
  crumb="Карта для игроков"
  parent={{ page: 'guides', name: 'Руководства' }}
  article={{ published: '2026-11-06', modified: '2026-11-06' }}
  schema={[howTo({ name: 'Как сделать карту для игроков с туманом войны в Loremapper', description, url: routeIn('tutFog', 'ru'), steps, minutes: 10, lang: 'ru' })]}
>
  <p class="lead">
    Карта для игроков показывает только то, что знают персонажи. В Loremapper вы закрашиваете туманом войны остальное, сами продолжаете видеть всё и
    выгружаете версию для стола, виртуального стола или вики кампании.
  </p>
  <figure>
    <Image class="shot" src={IMG.fog} alt="Фэнтези-карта в Loremapper: вид мастера сквозь туман и вид игроков со скрытыми землями" width={1200} widths={[760, 1200]} sizes="(max-width: 860px) 100vw, 760px" />
  </figure>
  <h2>Шаги</h2>
  <ol class="steps">
    {steps.map((s, i) => (
      <li id={`step-${i + 1}`}>
        <b>{s.name}.</b> {s.text}
      </li>
    ))}
  </ol>
  <h2>Полезно знать</h2>
  <ul>
    <li>Туман есть только на картинке для игроков; сама карта хранит всё.</li>
    <li>Картинки выгружаются шириной до 12 288 px — хватит для печати и приближения на виртуальном столе.</li>
    <li>Расстояния настоящие: линейка (U) покажет, сколько до соседнего города.</li>
  </ul>
  <h2>Дальше</h2>
  <p>
    Смотрите <a href={routeIn('dnd', 'ru')}>Loremapper для кампаний D&amp;D</a>, <a href={routeIn('tutContinent', 'ru')}>сгенерируйте материк</a> для игры
    или <a href={EDITOR}>откройте редактор</a>.
  </p>
</Article>
