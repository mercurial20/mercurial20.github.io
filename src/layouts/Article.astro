---
import Base from './Base.astro';
import { EDITOR, ROUTES, SITE, UI, type Lang, type PageId } from '../i18n';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  h1: string;
  /** The page's name in the breadcrumbs. */
  crumb: string;
  /** Written as an article (a guide), with dates. */
  article?: { published: string; modified: string };
  schema?: object[];
}

const { lang, page, title, description, h1, crumb, article, schema = [] } = Astro.props;
const ui = UI[lang];
const url = SITE + ROUTES[page][lang];
const all: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: SITE + ROUTES.home[lang] },
      { '@type': 'ListItem', position: 2, name: crumb, item: url },
    ],
  },
  ...(article
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: h1,
          description,
          inLanguage: lang,
          datePublished: article.published,
          dateModified: article.modified,
          url,
          image: SITE + '/social-preview.jpg',
          author: { '@type': 'Organization', name: 'Loremapper', url: SITE + '/' },
          publisher: { '@type': 'Organization', name: 'Loremapper', url: SITE + '/' },
        },
      ]
    : []),
  ...schema,
];
---

<Base lang={lang} page={page} title={title} description={description} schema={all}>
  <nav class="crumbs" aria-label={lang === 'en' ? 'Breadcrumbs' : 'Навигация'}>
    <a href={ROUTES.home[lang]}>{ui.home}</a> › <span>{crumb}</span>
  </nav>
  <article class="prose">
    <h1>{h1}</h1>
    <slot />
  </article>
  <section class="band">
    <div>
      <h2>{lang === 'en' ? 'Try it — it is free' : 'Попробуйте — это бесплатно'}</h2>
      <p>{ui.free}</p>
    </div>
    <a class="btn primary big" href={EDITOR}>{ui.open}</a>
  </section>
</Base>
