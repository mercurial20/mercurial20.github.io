---
import Base from './Base.astro';
import { EDITOR, routeIn, SITE, UI, type Lang, type PageId } from '../i18n';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  h1: string;
  /** The page's name in the breadcrumbs. */
  crumb: string;
  /** The section it is in (between home and it in the breadcrumbs). */
  parent?: { page: PageId; name: string };
  /** Written as an article (a guide), with dates. */
  article?: { published: string; modified: string };
  schema?: object[];
}

const { lang, page, title, description, h1, crumb, parent, article, schema = [] } = Astro.props;
const ui = UI[lang];
const url = SITE + routeIn(page, lang);
const trail = [{ name: ui.home, href: routeIn('home', lang) }, ...(parent ? [{ name: parent.name, href: routeIn(parent.page, lang) }] : [])];
const all: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [...trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE + c.href })), { '@type': 'ListItem', position: trail.length + 1, name: crumb, item: url }],
  },
  ...(article
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: h1,
          description,
          inLanguage: lang,
          datePublished: article.published,
          dateModified: article.modified,
          url,
          image: SITE + '/social-preview.jpg',
          author: { '@type': 'Organization', name: 'Loremapper', url: SITE + '/' },
          publisher: { '@type': 'Organization', name: 'Loremapper', url: SITE + '/' },
        },
      ]
    : []),
  ...schema,
];
---

<Base lang={lang} page={page} title={title} description={description} schema={all}>
  <nav class="crumbs" aria-label={lang === 'en' ? 'Breadcrumbs' : 'Навигация'}>
    {trail.map((c) => <><a href={c.href}>{c.name}</a> › </>)}<span>{crumb}</span>
  </nav>
  <article class="prose">
    <h1>{h1}</h1>
    <slot />
  </article>
  <section class="band">
    <div>
      <h2>{lang === 'en' ? 'Try it — it is free' : 'Попробуйте — это бесплатно'}</h2>
      <p>{ui.free}</p>
    </div>
    <a class="btn primary big" href={EDITOR}>{ui.open}</a>
  </section>
</Base>
