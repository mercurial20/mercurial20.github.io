---
import '@fontsource-variable/cinzel';
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/inter';
import '../styles/site.css';
import { EDITOR, GITHUB, REDDIT, ROUTES, SITE, UI, type Lang, type PageId } from '../i18n';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  /** Structured data for this page (schema.org objects). */
  schema?: object[];
  image?: string;
}

const { lang, page, title, description, schema = [], image = `${SITE}/social-preview.jpg` } = Astro.props;
const ui = UI[lang];
const other: Lang = lang === 'en' ? 'ru' : 'en';
const url = SITE + ROUTES[page][lang];
const navItems = (['generator', 'dnd', 'guide'] as const).map((id) => ({ id, href: ROUTES[id][lang], label: ui.nav[id] }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={SITE + ROUTES[page].en} />
    <link rel="alternate" hreflang="ru" href={SITE + ROUTES[page].ru} />
    <link rel="alternate" hreflang="x-default" href={SITE + ROUTES[page].en} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#111317" />
    <meta name="google-site-verification" content="p4k5g-oh4DCXa36kwV2D18UjJymPgPOIwkvmFPd426U" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={page === 'guide' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Loremapper" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class={`lang-${lang}`}>
    <header class="top">
      <a class="brand" href={ROUTES.home[lang]} aria-label="Loremapper">
        <img src="/favicon.svg" alt="" width="26" height="26" />
        <span>Loremapper</span>
      </a>
      <nav aria-label={lang === 'en' ? 'Pages' : 'Разделы'}>
        {navItems.map((n) => <a href={n.href} aria-current={n.id === page ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <a class="lang" href={ROUTES[page][other]} hreflang={other} lang={other}>{ui.lang}</a>
      <a class="btn primary" href={EDITOR}>{ui.openShort}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <p>{ui.footer}</p>
      <p class="links">
        <a href={EDITOR}>{ui.open}</a>
        <a href={GITHUB}>{ui.source}</a>
        <a href={REDDIT}>{ui.community}: r/LoreMapper</a>
        <a href={ROUTES[page][other]} hreflang={other} lang={other}>{ui.lang}</a>
      </p>
    </footer>
  </body>
</html>
